  "statements": [
    {
      "type": "General Statements: All Other Content",
      "notes": "Complete daily nutritional supplement"
    },
    {
      "type": "Formula re: Contains",
      "notes": "To enjoy optimum health, nutritional science recognizes that alongside a well-balanced diet, it is beneficial to supplement with the following essential nutrients:\n2 Omega-3 fatty acids"
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Pharmax Four Pillars is the most convenient way to create a solid nutritional foundation by providing the required daily levels of essential nutrients in four easy-to-take capsules or tablets."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Omega-3 fatty acids\nHelps maintain and support cardiovascular health."
    },
    {
      "type": "FDA Disclaimer Statement",
      "notes": "These statements have not been evaluated by the FDA. This product is not intended to diagnose, treat, cure or prevent any disease."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "30 Day supply"
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "Recommended adult intake: Contents of one serrated blister pack strip: 1 tablet, 1 softgel, 1 capsule (light brown) and 1 capsule (off-white), all taken once daily with a meal, at least two to three hours before or after taking medications or as professionally directed."
    },
    {
      "type": "Precautions re: All Other",
      "notes": "Risk information: Do not use if you have an immune-compromised condition."
    },
    {
      "type": "Precautions re: Pregnant or Nursing or Prescription Medications",
      "notes": "Consult your healthcare practitioner prior to use if you are pregnant or breastfeeding, taking any medication including cardiac glycosides (such as digitalis/digoxin), blood pressure medication, blood thinners or protease inhibitors, or have any health condition."
    },
    {
      "type": "Precautions re: All Other",
      "notes": "If symptoms of digestive upset occur, discontinue use and consult your healthcare practitioner. If hypersensitivity occurs, discontinue use."
    },
    {
      "type": "Precautions re: All Other",
      "notes": "Safety-sealed for your protection and for product freshness. Do not use if the blister pack has been tampered with."
    },
    {
      "type": "Storage",
      "notes": "Store in a cool, dry place."
    },
    {
      "type": "Precautions re: Children",
      "notes": "Keep out of reach of children."
    },
    {
      "type": "General: Product/Version Code",
      "notes": "V1.0 Code FP03-30"
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Omega-3 fatty acids"
