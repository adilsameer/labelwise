    {
      "type": "Formula re: Contains",
      "notes": "OmegaGenics EPA-DHA 2400 features a concentrated, purified source of omega-3 fatty acids from sustainably sourced, cold-water fish. Each teaspoon provides a total of 1,410 mg EPA and 990 mg DHA."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "All OmegaGenics formulas are tested for purity and quality and stabilized with antioxidants to maintain freshness. Learn more about TruQuality at WhyOmegaGenics.com.\nVitamin Angels\nMetagenics supports Vitamin Angels, helping at-risk populations in need--specifically pregnant women, new mothers, and children under five--gain access to lifesaving and life changing micronutrients."
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "Directions: Take one teaspoon once daily or as directed by your healthcare practitioner."
    },
    {
      "type": "Formulation re: Does NOT Contain",
      "notes": "This product is non-GMO and gluten-free."
    },
    {
      "type": "Precautions re: Pregnant or Nursing or Prescription Medications",
      "notes": "Caution: Consult your healthcare practitioner if pregnant, nursing, or taking other nutritional supplements or medications."
    },
    {
      "type": "Precautions re: Children",
      "notes": "Keep out of the reach of children."
    },
    {
      "type": "Storage",
      "notes": "Storage: Refrigerate after opening and use within 90 days. This oil may become cloudy when refrigerated, which is normal and does not alter product efficacy."
