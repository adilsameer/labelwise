  "statements": [
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "Pomegrante, Poten-Zyme(R) selenium, Boswellia serrata and natural astaxanthin provide antioxidant support to help scavenge free radical in the joint and cartilage tissue."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "ULTIMATE Joint & Cartilage Formula"
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Natural Shell-Fish Free Glucosamine 1,500mg"
    },
    {
      "type": "FDA Statement of Identity",
      "notes": "Whole Food Dietary Supplement"
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "Suggested Use: Adults take 4 capsules daily, with food. May take 2 capsules, twice per day."
    },
    {
      "type": "Precautions re: Children",
      "notes": "Not intended for children."
    },
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "+Produced using the Poten-Zyme(R) fermentation process"
    },
    {
      "type": "Precautions re: Children",
      "notes": "Keep out of reach of children."
    },
    {
      "type": "Formulation re: Vegetarian/Vegan",
      "notes": "Vegetarian."
    },
    {
      "type": "Seals/Symbols",
      "notes": "GLASS RECYCLES"
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "This multi-faceted formula provides clinically studied amounts of glucosamine, from a natural, shell-fish free source, along with a range of carefully selected natural antioxidants that assist the body's normal response to everyday wear and tear. Curcumin in turmeric supports normal joint and surrounding tissue volume and promotes healthy joint mobility by optimizing the level of enzymes that normally participate in protective tissue  response."
    },
    {
      "type": "Precautions re: Pregnant or Nursing or Prescription Medications",
      "notes": "Caution: As with any dietary supplement, consult your healthcare practitioner before using this  product, especially if you are pregnant, nursing, anticipate surgery, take medication on a regular basis or are otherwise under medical supervision."
    },
    {
      "type": "Precautions re: All Other",
      "notes": "Do not use if safety seal is broken or missing."
    },
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "FYI(R) ULTRA is the ultimate joint and cartilage formula, containing a broad spectrum of nutrients to support joint and connective tissue health."
    },
    {
      "type": "FDA Disclaimer Statement",
      "notes": "These statements have not been evaluated by the Food and Drug Administration. This product in not intended to diagnose, treat, cure or prevent any disease."
    },
    {
      "type": "Formulation re: Does NOT Contain",
      "notes": "Dairy Free. Gluten Free."
    },
    {
      "type": "Formulation re: Does NOT Contain",
      "notes": "Contains no artificial colors or preservatives."
    },
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "The FYI(R) ULTRA nutrients are delivered through our proprietary UltraZorbe(TM) capsules to provide faster and more complete dissolution than other vegetarian capsules, and are protected from the damaging effects of oxygen and moisture by our proprietary BioProtect(R) packaging system."
    },
    {
      "type": "General: Product/Version Code",
